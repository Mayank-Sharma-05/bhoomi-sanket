# Bhoomi Sanket Environment Variables Template
ADMIN_EMAIL=admin@bhoomisanket.gov.in
ADMIN_PASSWORD=Bhoomi@2026
AUTH_SECRET=your-secure-session-auth-key

# Clerk Authentication Configuration
# Obtain your keys from https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ML Service & Internal Microservices
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_SECRET=dev-secret-local-only
ML_SERVICE_TIMEOUT_MS=5000
ML_SERVICE_RETRIES=2
INTERNAL_API_SECRET=your-internal-api-secret
PYTHON_SERVICE_HOST=127.0.0.1
PYTHON_SERVICE_PORT=8000
PYTHON_SERVICE_RETRIES=2
PYTHON_SERVICE_TIMEOUT_MS=5000

# Supabase PostgreSQL Database Architecture (Prisma)
# 1. DATABASE_URL: Transaction Pooler connection string (Port 6543, with ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct database connection string (Port 5432, required for Prisma migrations / db push)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
